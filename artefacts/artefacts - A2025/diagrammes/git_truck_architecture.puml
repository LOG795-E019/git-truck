@startuml
!theme plain
title Git Truck — Architecture

actor "Utilisateur" as User

rectangle "Navigateur Web" {
  component "UI React\n(D3.js, Tailwind)" as UI
}

rectangle "Application Git Truck" {
  component "Remix\n(Routes, Loaders, SSR)" as Remix
  component "Backend Node.js\n(TypeScript, CLI, API)" as Backend
  database "DuckDB" as DuckDB
}

database "Dépôt Git Local" as Git

User --> UI : Actions
UI --> Remix : HTTP
Remix --> Backend : Appels internes
Backend --> DuckDB : SQL analytique
Backend --> Git : Commandes Git\n(log, tree, blame)
DuckDB --> Remix : Résultats de requêtes
Remix --> UI : SSR / JSON

@enduml
